APP_NAME=MEDUSA Backend
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://medusa:medusa_dev_only@localhost:5432/medusa
REDIS_URL=redis://localhost:6379/0
SUBMISSION_REQUEST_LIMIT=60
INCORRECT_SUBMISSION_LIMIT=10
SUBMISSION_RATE_WINDOW_SECONDS=60
REGISTRATION_REQUEST_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=600
TOKEN_REQUEST_LIMIT_PER_IP=20
TOKEN_REQUEST_LIMIT_PER_ACCOUNT=5
TOKEN_RATE_WINDOW_SECONDS=60
# Development-only placeholder. Generate a unique secret of at least 32 characters for each deployment.
AUTH_SECRET_KEY=development-only-change-this-key-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=15
TOKEN_ISSUER=medusa-backend
