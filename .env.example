APP_NAME=MEDUSA Backend
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://medusa:medusa_dev_only@localhost:5432/medusa
REDIS_URL=redis://localhost:6379/0
# JSON array of exact browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:8080"]
SUBMISSION_REQUEST_LIMIT=60
INCORRECT_SUBMISSION_LIMIT=10
SUBMISSION_RATE_WINDOW_SECONDS=60
REGISTRATION_REQUEST_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=600
TOKEN_REQUEST_LIMIT_PER_IP=20
TOKEN_REQUEST_LIMIT_PER_ACCOUNT=5
TOKEN_RATE_WINDOW_SECONDS=60
# Development-only placeholder. Generate a unique secret of at least 32 characters for each deployment.
AUTH_SECRET_KEY=development-only-change-this-key-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=15
TOKEN_ISSUER=medusa-backend

# Password reset: SMTP is optional in development; without it, reset emails cannot be delivered.
# Production startup requires SMTP_HOST and SMTP_FROM_EMAIL.
PASSWORD_RESET_REQUEST_LIMIT_PER_IP=10
PASSWORD_RESET_REQUEST_LIMIT_PER_EMAIL=3
PASSWORD_RESET_CONFIRM_LIMIT_PER_IP=10
PASSWORD_RESET_RATE_WINDOW_SECONDS=600
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL=http://localhost:8080/reset-password
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@medusa.local
SMTP_USE_TLS=false

# Sandbox lifecycle policy (conservative defaults)
SANDBOX_MAX_ACTIVE_PER_OWNER=2
SANDBOX_MAX_ACTIVE_PER_COMPETITION=20
SANDBOX_MAX_LIFETIME_MINUTES=120
