@baseUrl = http://localhost:8000/api/v1
@email = reset-test@example.com
@password = change-this-to-a-long-test-password
@newPassword = a-different-long-test-password

### 1. Register a test account (skip if already registered)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### 2. Request a reset (always returns 202 with a generic response)
# Configure SMTP in .env and check the test mailbox.
# This API deliberately does not return the raw reset token.
POST {{baseUrl}}/auth/password-reset/request
Content-Type: application/json

{
  "email": "{{email}}"
}

###

### 3. Confirm reset using the token from the email link
# Copy the token query parameter from the reset link.
@resetToken = replace-with-token-from-email
POST {{baseUrl}}/auth/password-reset/confirm
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "new_password": "{{newPassword}}"
}

###

### 4. Old password should fail (401)
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username={{email}}&password={{password}}

###

### 5. New password should succeed (200)
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username={{email}}&password={{newPassword}}

###

### 6. Reusing the reset token should fail (400)
POST {{baseUrl}}/auth/password-reset/confirm
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "new_password": "another-long-password-123"
}
