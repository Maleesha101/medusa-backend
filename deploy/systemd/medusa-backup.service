[Unit]
Description=MEDUSA PostgreSQL backup and encrypted off-site replication
Wants=network-online.target
After=network-online.target docker.service
OnFailure=medusa-backup-alert@%n.service

[Service]
Type=oneshot
User=medusa-backup
Group=docker
UMask=0077
ExecStart=/opt/medusa/venv/bin/python /opt/medusa/scripts/run_production_postgres_backup_pipeline.py --env-file /etc/medusa/.env.production --backup-dir /mnt/medusa-backups --rclone-config /etc/medusa/rclone.conf --remote medusa-vault --remote-dir medusa-postgres-backups --retention-days 30
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/mnt/medusa-backups
