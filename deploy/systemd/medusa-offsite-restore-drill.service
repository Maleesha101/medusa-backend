[Unit]
Description=MEDUSA encrypted off-site PostgreSQL restore verification drill
Wants=network-online.target
After=network-online.target docker.service
OnFailure=medusa-backup-alert@%n.service

[Service]
Type=oneshot
User=medusa-backup
Group=docker
UMask=0077
WorkingDirectory=/opt/medusa
ExecStart=/opt/medusa/venv/bin/python -m scripts.verify_offsite_production_postgres_backup --config /etc/medusa/rclone.conf --remote medusa-vault --remote-dir medusa-postgres-backups --temp-dir /mnt/medusa-backups
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/mnt/medusa-backups
