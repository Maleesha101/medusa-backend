# Copy to .env.production, set real values, and chmod 600 .env.production.
# Generate URL-safe database/cache passwords with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-64-character-hex-secret
REDIS_PASSWORD=replace-with-a-different-64-character-hex-secret

# Generate with: openssl rand -hex 32 (or another secure 32+ character secret)
AUTH_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters

# Public HTTPS URL of the frontend password-reset page.
PASSWORD_RESET_URL=https://app.example.com/reset-password

# Production SMTP configuration. SMTP_HOST and SMTP_FROM_EMAIL are required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=medusa@example.com
SMTP_USE_TLS=true

# Optional host loopback port for the API (default 8000).
API_PORT=8000
